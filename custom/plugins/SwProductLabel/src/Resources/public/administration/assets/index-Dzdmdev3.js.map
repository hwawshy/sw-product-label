{% block sw_product_label_detail %}
<sw-page class="sw-product-label-detail">

    {% block sw_product_label_detail_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ placeholder(productLabel, 'name', $t('sw-product-label.detail.textHeadline')) }}</h2>
    </template>
    {% endblock %}

    {% block sw_product_label_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_product_label_detail_smart_bar_actions_cancel %}
        <mt-button
            variant="secondary"
            size="default"
            :disabled="isLoading || undefined"
            @click="onCancel"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_product_label_detail_smart_bar_actions_save %}
        <sw-button-process
            variant="primary"
            :is-loading="isLoading || undefined"
            :process-success="isSaveSuccessful"
            :disabled="isLoading || undefined"
            @update:process-success="saveFinish"
            @click.prevent="onSave"
        >
            {{ $t('global.default.save') }}
        </sw-button-process>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_product_label_detail_language_switch %}
    <template #language-switch>
        <sw-language-switch
            v-if="productLabel && !productLabel.isNew()"
            :save-changes-function="saveOnLanguageChange"
            :abort-change-function="abortOnLanguageChange"
            @on-change="onChangeLanguage"
        />
    </template>
    {% endblock %}

    {% block sw_product_label_detail_content %}
    <template #content>
        <sw-card-view>
            <template v-if="isLoading">
                <sw-skeleton variant="detail-bold" />
                <sw-skeleton />
            </template>

            <div v-if="!isLoading">

                {% block sw_product_label_detail_content_language_info %}
                <sw-language-info
                    :entity-description="placeholder(productLabel, 'name', $t('sw-product-label.detail.textHeadline'))"
                    :is-child="false"
                />
                {% endblock %}

                {% block sw_product_label_detail_content_card %}
                <sw-card :title="$t('sw-product-label.detail.cardTitle')" :is-loading="isLoading">

                    {% block sw_product_label_detail_content_form %}
                    <sw-container columns="1fr 1fr" gap="0px 30px">

                        {% block sw_product_label_detail_content_form_name %}
                        <mt-text-field
                            v-model="productLabel.name"
                            name="sw-field--productLabel-name"
                            :label="$t('sw-product-label.detail.labelName')"
                            required
                        />
                        {% endblock %}

                        {% block sw_product_label_detail_content_form_color %}
                        <mt-colorpicker
                            v-model="productLabel.color"
                            name="sw-field--productLabel-color"
                            :label="$t('sw-product-label.detail.labelColor')"
                            :z-index="1000"
                            required
                        />
                        {% endblock %}

                        {% block sw_product_label_detail_content_form_priority %}
                        <mt-number-field
                            v-model="productLabel.priority"
                            name="sw-field--productLabel-priority"
                            number-type="int"
                            :label="$t('sw-product-label.detail.labelPriority')"
                        />
                        {% endblock %}

                        {% block sw_product_label_detail_content_form_active %}
                        <mt-switch
                            v-model="productLabel.active"
                            name="sw-field--productLabel-active"
                            :label="$t('sw-product-label.detail.labelActive')"
                        />
                        {% endblock %}

                        {% block sw_product_label_detail_content_form_valid_from %}
                        <mt-datepicker
                            v-model="productLabel.validFrom"
                            name="sw-field--productLabel-validFrom"
                            :label="$t('sw-product-label.detail.labelValidFrom')"
                        />
                        {% endblock %}

                        {% block sw_product_label_detail_content_form_valid_to %}
                        <mt-datepicker
                            v-model="productLabel.validTo"
                            name="sw-field--productLabel-validTo"
                            :label="$t('sw-product-label.detail.labelValidTo')"
                        />
                        {% endblock %}

                    </sw-container>
                    {% endblock %}

                </sw-card>
                {% endblock %}

            </div>
        </sw-card-view>
    </template>
    {% endblock %}

</sw-page>
{% endblock %}
