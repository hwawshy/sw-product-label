{% block sw_product_detail_labels %}
<sw-card-view>
    {% block sw_product_detail_labels_assignment_card %}
    <sw-many-to-many-assignment-card
        v-if="product && product.productLabels"
        :title="$t('sw-product-label.productDetail.assignmentCardTitle')"
        :entity-collection="product.productLabels"
        :columns="labelColumns"
        :is-loading="isLoading"
        :local-mode="product.isNew()"
        :searchable-fields="['name']"
        :select-label="$t('sw-product-label.productDetail.assignmentLabel')"
        :placeholder="$t('sw-product-label.productDetail.assignmentPlaceholder')"
    />
    {% endblock %}
</sw-card-view>
{% endblock %}
